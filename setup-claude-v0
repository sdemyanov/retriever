def yaml_quote(value: str) -> str:
    return json.dumps(value)


def shell_quote(path: Path | str) -> str:
    return shlex.quote(str(path))


def command_filename(command_name: str, prefix: str) -> str:
    return f"{prefix}{command_name}.md"


def validate_prefix(prefix: str) -> None:
    if not re.fullmatch(r"[A-Za-z0-9_-]*", prefix):
        raise SystemExit("Command prefix may only contain letters, numbers, underscores, and hyphens.")


def render_frontmatter(description: str, tool_path: Path) -> str:
    allowed_tools = f"Bash(python3 {shell_quote(tool_path)}:*)"
    return "\n".join(
        (
            "---",
            f"description: {yaml_quote(description)}",
            f"allowed-tools: {yaml_quote(allowed_tools)}",
            "---",
            "",
        )
    )


def render_slash_command(spec: SlashCommandSpec, *, workspace_root: Path, tool_path: Path, repo_root: Path) -> str:
    base_command = f"/{spec.name}"
    example = f"python3 {shell_quote(tool_path)} --human slash {shell_quote(workspace_root)} '<slash command text>'"
    if spec.name == "export":
        execution_block = (
            "```bash\n"
            + "slash_args=\"$ARGUMENTS\"\n"
            + "if [ -z \"$slash_args\" ]; then\n"
            + "  slash_command=\"/export\"\n"
            + "else\n"
            + "  slash_command=\"/export $slash_args\"\n"
            + "fi\n"
            + "case \"$slash_args\" in\n"
            + "  table*|csv*|archive*)\n"
            + "    case \" $slash_command \" in\n"
            + "      *\" --run-to-completion \"*) ;;\n"
            + "      *) slash_command=\"$slash_command --run-to-completion\" ;;\n"
            + "    esac\n"
            + "    ;;\n"
            + "esac\n"
            + f"python3 {shell_quote(tool_path)} --human slash {shell_quote(workspace_root)} \"$slash_command\"\n"
            + "```\n\n"
        )
        slash_guidance = (
            "Build the slash command from the user arguments, then run the shell script above exactly once.\n"
            "- `/export table ...` and `/export archive ...` should always keep the hidden `--run-to-completion` suffix.\n"
            "- `/export status ...` should pass through unchanged.\n\n"
        )
    else:
        execution_block = "```bash\n" + example + "\n```\n\n"
        slash_guidance = (
            "Build `<slash command text>` as:\n"
            + f"- `{base_command}` if no user arguments were provided\n"
            + f"- otherwise `{base_command} ` followed by the exact user arguments\n\n"
            + "Quote the full slash command as one shell argument safely.\n\n"
        )
    return (
        render_frontmatter(spec.description, tool_path)
        + MANAGED_MARKER
        + "\n\n"
        + f"# Retriever {base_command}\n\n"
        + "Use Retriever's existing persistent browse/session surface for this workspace.\n\n"
        + f"- Workspace root: `{workspace_root}`\n"
        + f"- Retriever repo: `{repo_root}`\n"
        + "- User arguments: `$ARGUMENTS`\n\n"
        + "Use the Bash tool to run exactly one Retriever command:\n\n"
        + execution_block
        + slash_guidance
        + "Return stdout exactly as the entire response. No preamble. No commentary. No reformatting.\n"
    )


def render_fixed_command(spec: FixedCommandSpec, *, workspace_root: Path, tool_path: Path, repo_root: Path) -> str:
    argv = ["python3", str(tool_path), "--human", *spec.argv_after_tool, str(workspace_root)]
    display_command = " ".join(shell_quote(part) for part in argv)
    return (
        render_frontmatter(spec.description, tool_path)
        + MANAGED_MARKER
        + "\n\n"
        + f"# Retriever /{spec.name}\n\n"
        + f"- Workspace root: `{workspace_root}`\n"
        + f"- Retriever repo: `{repo_root}`\n\n"
        + "Use the Bash tool to run exactly one Retriever command:\n\n"
        + "```bash\n"
        + display_command
        + "\n```\n\n"
        + "Return stdout exactly as the entire response. No preamble. No commentary. No reformatting.\n"
        + "\n"
    )


def render_workspace_args_command(
    spec: WorkspaceArgsCommandSpec, *, workspace_root: Path, tool_path: Path, repo_root: Path
) -> str:
    always_args_display = " ".join(shell_quote(arg) for arg in spec.always_args)
    default_args_display = " ".join(shell_quote(arg) for arg in spec.default_args_if_empty)
    if spec.workspace_position == "first":
        if default_args_display:
            display_command = (
                f"python3 {shell_quote(tool_path)} --human {spec.subcommand} "
                + (f"{always_args_display} " if always_args_display else "")
                + f"{shell_quote(workspace_root)} "
                + "[user arguments or default arguments]"
            )
        else:
            display_command = (
                f"python3 {shell_quote(tool_path)} --human {spec.subcommand} "
                + (f"{always_args_display} " if always_args_display else "")
                + f"{shell_quote(workspace_root)} [user arguments]"
            )
        placement_rule = "Place the workspace path before the user arguments."
    elif spec.workspace_position == "last":
        if default_args_display:
            display_command = (
                f"python3 {shell_quote(tool_path)} --human {spec.subcommand} "
                + (f"{always_args_display} " if always_args_display else "")
                + "[user arguments or default arguments] "
                + f"{shell_quote(workspace_root)}"
            )
        else:
            display_command = (
                f"python3 {shell_quote(tool_path)} --human {spec.subcommand} "
                + (f"{always_args_display} " if always_args_display else "")
                + f"[user arguments] {shell_quote(workspace_root)}"
            )
        placement_rule = "Place all user arguments before the workspace path."
    else:
        raise ValueError(f"Unknown workspace_position: {spec.workspace_position}")

    if spec.default_args_if_empty:
        empty_args_rule = (
            "If the user did not provide any arguments, use these default arguments instead: "
            f"`{default_args_display}`."
        )
    else:
        empty_args_rule = "If no arguments are needed, omit `[user arguments]` entirely."

    if spec.always_args:
        always_args_rule = "Always include these arguments: " f"`{always_args_display}`."
    else:
        always_args_rule = None

    return (
        render_frontmatter(spec.description, tool_path)
        + MANAGED_MARKER
        + "\n\n"
        + f"# Retriever /{spec.name}\n\n"
        + f"- Workspace root: `{workspace_root}`\n"
        + f"- Retriever repo: `{repo_root}`\n"
        + "- User arguments: `$ARGUMENTS`\n\n"
        + "Use the Bash tool to run exactly one Retriever command:\n\n"
        + "```bash\n"
        + display_command
        + "\n```\n\n"
        + placement_rule
        + "\n"
        + spec.arguments_hint
        + "\n\n"
        + (always_args_rule + "\n\n" if always_args_rule else "")
        + empty_args_rule
        + "\n\n"
        + ("\n".join(spec.extra_guidance) + "\n\n" if spec.extra_guidance else "")
        + "Return stdout exactly as the entire response. No preamble. No commentary. No reformatting.\n"
        + "\n"
    )


def discover_basename_collisions(commands_root: Path, target_names: set[str], managed_paths: set[Path]) -> list[Path]:
    collisions: list[Path] = []
    if not commands_root.exists():
        return collisions
    for path in commands_root.rglob("*.md"):
        if path in managed_paths:
            continue
        if path.stem in target_names:
            collisions.append(path)
    return sorted(collisions)


def load_manifest(path: Path) -> dict[str, object] | None:
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def managed_paths_from_manifest(manifest: dict[str, object] | None, workspace_root: Path) -> set[Path]:
    if not manifest:
        return set()
    files = manifest.get("files")
    if not isinstance(files, list):
        return set()
    result: set[Path] = set()
    for relpath in files:
        if isinstance(relpath, str):
            result.add(workspace_root / relpath)
    return result


def remove_previous_managed_files(paths: set[Path], commands_dir: Path) -> None:
    for path in sorted(paths, reverse=True):
        if not path.exists():
            continue
        if commands_dir not in path.parents:
            continue
        path.unlink()


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Install Retriever v0 Claude Code commands into one target workspace."
    )
    parser.add_argument("workspace", help="Target workspace that should receive project-local Claude commands.")
    parser.add_argument(
        "--prefix",
        default="",
        help="Optional command-name prefix, e.g. retriever-. Defaults to no prefix.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Overwrite existing Retriever-managed files and ignore command-name collisions.",
    )
    parser.add_argument(
        "--repo-root",
        default=str(REPO_ROOT),
        help="Retriever checkout to call from installed commands. Defaults to this repository.",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    validate_prefix(args.prefix)

    workspace_root = Path(args.workspace).expanduser().resolve()
    repo_root = Path(args.repo_root).expanduser().resolve()
    tool_path = repo_root / "skills" / "tool-template" / "tools.py"

    if not workspace_root.exists():
        raise SystemExit(f"Workspace does not exist: {workspace_root}")
    if not workspace_root.is_dir():
        raise SystemExit(f"Workspace is not a directory: {workspace_root}")
    if not tool_path.exists():
        raise SystemExit(f"Could not find Retriever tools.py at: {tool_path}")

    commands_root = workspace_root / ".claude" / "commands"
    commands_dir = workspace_root / COMMANDS_SUBDIR
    manifest_path = workspace_root / MANIFEST_PATH
    previous_manifest = load_manifest(manifest_path)
    previous_managed_files = managed_paths_from_manifest(previous_manifest, workspace_root)

    slash_outputs = {
        command_filename(spec.name, args.prefix): render_slash_command(
            spec, workspace_root=workspace_root, tool_path=tool_path, repo_root=repo_root
        )
        for spec in SLASH_COMMANDS
    }
    fixed_outputs = {
        command_filename(spec.name, args.prefix): render_fixed_command(
            spec, workspace_root=workspace_root, tool_path=tool_path, repo_root=repo_root
        )
        for spec in FIXED_COMMANDS
    }
    workspace_arg_outputs = {
        command_filename(spec.name, args.prefix): render_workspace_args_command(
            spec, workspace_root=workspace_root, tool_path=tool_path, repo_root=repo_root
        )
        for spec in WORKSPACE_ARGS_COMMANDS
    }

    rendered_files = {**slash_outputs, **fixed_outputs, **workspace_arg_outputs}
    target_paths = {commands_dir / filename for filename in rendered_files}
    target_names = {path.stem for path in target_paths}

    collisions = discover_basename_collisions(commands_root, target_names, previous_managed_files)
    if collisions and not args.force:
        collision_list = "\n".join(f"- {path}" for path in collisions)
        raise SystemExit(
            "Refusing to install because these Claude command names already exist in the target workspace:\n"
            + collision_list
            + "\nRe-run with --prefix retriever- to avoid name conflicts, or use --force if you want to replace your existing Retriever-managed install."
        )

    commands_dir.mkdir(parents=True, exist_ok=True)
    remove_previous_managed_files(previous_managed_files - target_paths, commands_dir)

    for filename, content in sorted(rendered_files.items()):
        (commands_dir / filename).write_text(content, encoding="utf-8")

    manifest = {
        "schema_version": 1,
        "workspace_root": str(workspace_root),
        "repo_root": str(repo_root),
        "command_prefix": args.prefix,
        "command_subdir": str(COMMANDS_SUBDIR),
        "files": [str(path.relative_to(workspace_root)) for path in sorted(target_paths)],
    }
    manifest_path.parent.mkdir(parents=True, exist_ok=True)
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(f"Installed {len(rendered_files)} Retriever Claude commands into {commands_dir}")
    print("Open Claude Code in that workspace and run `/help` to see the new commands.")
    if args.prefix:
        print(f"Commands were installed with prefix {args.prefix!r}.")
    else:
        print("Commands were installed without a prefix. Re-run with `--prefix retriever-` if the workspace later gains command-name conflicts.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
