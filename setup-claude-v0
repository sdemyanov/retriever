#!/usr/bin/env python3
"""Install a minimal Claude Code command bridge for Retriever into one workspace.

This v0 bridge keeps Retriever's current plugin/backend structure intact and
adds project-local Claude commands that call the existing bundled tools.py.
"""
from __future__ import annotations

import argparse
import json
import re
import shlex
import sys
from dataclasses import dataclass
from pathlib import Path


